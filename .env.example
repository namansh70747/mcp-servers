# Copy to .env and fill in. .env is gitignored. All values below are FREE.

# === GitHub (free fine-grained PAT) ===
# Used by: github (ready-made), github-profile, readme-changelog, email-finder (commit emails)
GITHUB_PERSONAL_ACCESS_TOKEN=

# === Google OAuth (your OWN free Google Cloud project) ===
# Used by: google_workspace (Calendar/Drive/Docs/Gmail), reachout, mailbox
# One Desktop OAuth client, reused everywhere. Enable Calendar/Drive/Docs/Gmail APIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Outreach pipeline ===
# SEC EDGAR fair-access REQUIRES a descriptive User-Agent with a contact email:
SEC_USER_AGENT=Naman Sharma naman@example.com
# Apollo web mode (Option B): background Chrome/Edge via CDP
#   automation/setup-apollo-web.ps1  OR  apollo.start_background_browser()
# Also log into LinkedIn + install Apollo Chrome extension in the same browser profile
# (find_person_email uses LinkedIn extension sidebar as fallback).
APOLLO_MODE=web
BROWSER_CDP_URL=http://127.0.0.1:9222
BROWSER_USER_DATA_DIR=
# Auto Google login for Apollo — manual mode recommended (Google blocks CDP password entry)
APOLLO_AUTO_LOGIN=1
APOLLO_LOGIN_MODE=manual
APOLLO_MANUAL_WAIT_SECONDS=300
APOLLO_GOOGLE_EMAIL=
APOLLO_GOOGLE_PASSWORD=
# Apollo API (only if APOLLO_MODE=api): https://www.apollo.io/ -> Settings -> API
APOLLO_API_KEY=
# Reoon email verifier: FREE 600/mo, API key included. Primary verifier.
REOON_API_KEY=
# Hunter.io: FREE 50/mo finder+verifier. Secondary.
HUNTER_API_KEY=

# === Spotify (FREE; only needed for search / play-by-name — basic playback works without keys) ===
# developer.spotify.com/dashboard -> Create app -> copy Client ID + Secret. No Premium required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# === LLM providers (Apollo person-matching tiebreak + optional agent backends) ===
# Ordered fallback chain — first provider with a key wins. When Cline expires, drop it:
#   LLM_PROVIDER_CHAIN=nvidia,grok,gemini,ollama
LLM_PROVIDER_CHAIN=cline,nvidia,grok,gemini,ollama

# Cline — https://app.cline.bot/dashboard/account?tab=api-keys
CLINE_API_KEY=
CLINE_API_BASE_URL=https://api.cline.bot/api/v1
CLINE_MODEL=anthropic/claude-sonnet-4-6

# NVIDIA NIM (Kimi) — https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k2-instruct

# Grok (xAI) — https://console.x.ai/
GROK_API_KEY=
# XAI_API_KEY=   # alias for GROK_API_KEY
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-fast

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.0-flash

# Ollama local (free) — run `ollama serve` then `ollama pull qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_API_KEY=ollama

# Legacy / CLI mirrors (optional)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3-coder:30b

# === Paths ===
# Where servers keep their SQLite DBs / caches. Defaults to ~/.mcp-suite
MCP_DATA_DIR=

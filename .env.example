# Copy to .env and fill in. .env is gitignored. All values below are FREE.

# === GitHub (free fine-grained PAT) ===
# Used by: github (ready-made), github-profile, readme-changelog, email-finder (commit emails)
GITHUB_PERSONAL_ACCESS_TOKEN=

# === Google OAuth (your OWN free Google Cloud project) ===
# Used by: google_workspace (Calendar/Drive/Docs/Gmail), reachout, mailbox
# One Desktop OAuth client, reused everywhere. Enable Calendar/Drive/Docs/Gmail APIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Outreach pipeline ===
# SEC EDGAR fair-access REQUIRES a descriptive User-Agent with a contact email:
SEC_USER_AGENT=Naman Sharma naman@example.com
# Apollo: OPTIONAL. Free plan = people-search only (email reveal is paid). Leave blank to skip.
APOLLO_API_KEY=
# Reoon email verifier: FREE 600/mo, API key included. Primary verifier.
REOON_API_KEY=
# Hunter.io: FREE 50/mo finder+verifier. Secondary.
HUNTER_API_KEY=

# === Spotify (FREE; only needed for search / play-by-name — basic playback works without keys) ===
# developer.spotify.com/dashboard -> Create app -> copy Client ID + Secret. No Premium required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# === Free model backends for Qwen Code / Kimi CLI (optional) ===
# Ollama local (free): run `ollama serve` then point the CLIs here.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3-coder:30b

# === videoforge (FREE; the engine is a system binary, no API key) ===
# Requires: brew install ffmpeg  (bundles ffprobe). Transcription/auto-captions: uv pip install faster-whisper.
# Some Homebrew ffmpeg bottles omit drawtext/subtitles/vidstab; videoforge detects this and tells you
# how to get a fuller build. Override the binaries here only if they're not on PATH:
# FFMPEG_BIN=
# FFPROBE_BIN=
# WHISPER_BACKEND=faster-whisper   # reserved for a future whisper.cpp backend
# Any-length tuning (defaults are fine): heavy edits wait inline up to INLINE_WAIT sec for a snappy
# result on short clips, else run UNBOUNDED as a background job (poll job_status). Apple hardware
# encoding (videotoolbox, 5-10x faster) auto-engages once a source is longer than HW_THRESHOLD sec.
# VIDEOFORGE_INLINE_WAIT=20
# VIDEOFORGE_HW_THRESHOLD=600

# === whatsapp + chrome (FREE; drive YOUR real Chrome, already logged in — no QR) ===
# Robust path uses WhatsApp's own engine (WPPConnect window.WPP) injected by a one-time unpacked Chrome
# extension — see integrations/whatsapp-wpp-extension/README.md. Plus: Chrome → View → Developer →
# "Allow JavaScript from Apple Events" + the Automation grant. macOS + Chrome. Talk to anyone by NAME/
# nickname (fuzzy) in YOUR per-contact voice; learns/persists nicknames, resolutions, tone, episodes.
# ⚠️ Automating WhatsApp's engine is against WhatsApp's ToS and bypasses rate limits — keep volume modest.
# CHROME_APP=Google Chrome           # e.g. "Google Chrome Beta"
# WHATSAPP_FUZZY_THRESHOLD=0.72      # auto-pick confidence for name matching (else asks "did you mean?")
# WHATSAPP_WPP_TIMEOUT=30            # sec to await a WPP call
# WHATSAPP_INLINE_WAIT=14            # sec an action waits inline before returning a job_id
# WHATSAPP_THROTTLE_SECONDS=3        # gap after each send (ban-safety)
# --- autopilot (autonomous conversation; triggered by "autopilot" in your prompt) ---
# WHATSAPP_AUTOPILOT_STOPWORDS=bye,bye bye,ok bye,goodbye,ttyl,gtg,good night,gn,stop,ruk,band karo
# WHATSAPP_AUTOPILOT_IDLE_TIMEOUT=180  # sec with no reply before autopilot stops
# WHATSAPP_AUTOPILOT_MAX_TURNS=40      # max back-and-forth turns before autopilot stops

# === background ("run any task in the background" engine) ===
# run(task) spawns a detached headless `claude -p` with the full suite. No keys (uses your Claude).
# BACKGROUND_MAX_CONCURRENT=4    # how many background tasks run at once
# BACKGROUND_TIMEOUT=1800        # per-task timeout (sec)
# BACKGROUND_INLINE_WAIT=8       # sec a task waits inline before returning a job_id
# BACKGROUND_YOLO=0             # 1 = headless runs use --dangerously-skip-permissions (max autonomy)
# CLAUDE_BIN=                   # path to the `claude` CLI if not on PATH

# === Paths ===
# Where servers keep their SQLite DBs / caches. Defaults to ~/.mcp-suite
MCP_DATA_DIR=

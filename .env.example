# Copy to .env and fill in. .env is gitignored. All values below are FREE.

# === GitHub (free fine-grained PAT) ===
# Used by: github (ready-made), github-profile, readme-changelog, email-finder (commit emails)
GITHUB_PERSONAL_ACCESS_TOKEN=

# === Google OAuth (your OWN free Google Cloud project) ===
# Used by: google_workspace (Calendar/Drive/Docs/Gmail), reachout, mailbox
# One Desktop OAuth client, reused everywhere. Enable Calendar/Drive/Docs/Gmail APIs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# === Outreach pipeline ===
# SEC EDGAR fair-access REQUIRES a descriptive User-Agent with a contact email:
SEC_USER_AGENT=Naman Sharma naman@example.com
# Apollo: OPTIONAL. Free plan = people-search only (email reveal is paid). Leave blank to skip.
APOLLO_API_KEY=

# === email-finder / emailcheck (ALL OPTIONAL — the keyless free backbone needs NONE of these) ===
# The finder+verifier work fully with zero keys (MX+DoH, SMTP signal, account-enumeration, Gravatar,
# site harvest, multi-engine search, PGP/crt.sh, patterns). Keys below are bonus accelerators only,
# credit-rationed + auto-rotated. EVERY key supports comma-separated MULTI-KEY rotation, e.g.
#   HUNTER_API_KEY=key1,key2,key3
# CREDIT-INDEPENDENCE: when Apollo reveal credits run out, the FINDERS (name+domain -> real email, NO
# Apollo credit) + the VERIFIERS power a multi-source CONSENSUS — an email is HIGH only when 2+ agree.
# NO key needed: Rapid + Disify verifiers, Common Crawl harvest, theHarvester, and the Hunter email-
# FINDER (reuses HUNTER_API_KEY). When you DO set a key, put the value right after = with NO trailing
# inline comment (this parser would treat the comment as part of the value).
REOON_API_KEY=            # verifier 600/mo free — reoon.com
HUNTER_API_KEY=           # finder + verifier 50/mo free — hunter.io
TOMBA_API_KEY=            # finder + verifier 50/mo free (work email; Gmail blocked) — tomba.io
TOMBA_SECRET=
# FREE FINDERS (sign up free, no card):
PROSPEO_API_KEY=          # 75-100 free, also LinkedIn->email — prospeo.io
GETPROSPECT_API_KEY=      # 50/mo — getprospect.com
MINELEAD_API_KEY=         # 25/mo — minelead.io
EMAILVERIFY_IO_API_KEY=   # 10 finds + 100 verifies/mo — emailverify.io
GENERECT_API_KEY=         # 50 free — generect.com
# FREE VERIFIERS:
MYEMAILVERIFIER_API_KEY=  # 100 per DAY, no card — myemailverifier.com
ABSTRACT_API_KEY=         # 100/mo — app.abstractapi.com/api/email-validation
MAILBOXLAYER_API_KEY=     # ~100/mo — mailboxlayer.com
VERIFALIA_USERNAME=       # 25/day, optional (browser-app user + password) — verifalia.com
VERIFALIA_PASSWORD=
# UNLIMITED self-hosted SMTP verify: `docker run -p 8080:8080 reacherhq/backend:latest`, then set:
REACHER_BASE_URL=         # http://localhost:8080
# NOT free for API: SKRAPP_API_KEY (Skrapp API is paid-only), SNOV_USER_ID/SNOV_SECRET (Snov free API
# is support-gated — email help@snov.io to enable). Add them only if you've unlocked API access.
# Extra FREE reveal browser-extensions for the pool (install in the debug Chrome + log in once; the
# reveal cascade auto-rotates to them when Apollo credits run out): ContactOut (100/mo), Lusha (70/mo),
# GetProspect/Skrapp/Snov (50/mo), Wiza/Kaspr (25/mo). See extension_pool_status() for live balances.
# Optional self-hosted FREE services (Docker; called over HTTP, never embedded). Absent → skipped.
REACHER_BASE_URL=         # e.g. http://localhost:8080  (reacherhq/backend — best OSS SMTP verifier)
FIRECRAWL_URL=            # e.g. http://localhost:3002  (Firecrawl LLM-ready scraper)
SEARXNG_URL=              # e.g. http://localhost:8888  (self-hosted SearXNG metasearch, F5)
# SEARXNG_TOR_PROXY=socks5://127.0.0.1:9050   # optional Tor IP-rotation for SearXNG
# EMAIL_SMTP_PROXY=socks5://127.0.0.1:9050    # route SMTP probes through a SOCKS proxy (port-25 bypass)
# OLLAMA_HOST=http://localhost:11434          # local LLM for F2 quote-or-abstain extraction
# OLLAMA_EMAIL_MODEL=llama3.2
# TWITTER_BEARER_TOKEN=                       # override the public web token used by account-enumeration
# --- Free browser-extension reveal pool (opt-in, ToS-flagged, human-in-the-loop) ---
# Drives YOUR real logged-in Chrome where these free extensions are installed (Apollo/ContactOut/
# Lusha/GetProspect/Skrapp/Snov/Wiza/Kaspr). No API keys — credits tracked + rotated automatically.
# Gated behind find_by_company(use_extensions=True). ⚠️ Automating logged-in LinkedIn at scale
# violates ToS and risks account restriction — the keyless backbone is the default; use this sparingly.

# === Spotify (FREE; only needed for search / play-by-name — basic playback works without keys) ===
# developer.spotify.com/dashboard -> Create app -> copy Client ID + Secret. No Premium required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# === Free model backends for Qwen Code / Kimi CLI (optional) ===
# Ollama local (free): run `ollama serve` then point the CLIs here.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3-coder:30b

# === videoforge (FREE; the engine is a system binary, no API key) ===
# Requires: brew install ffmpeg  (bundles ffprobe). Transcription/auto-captions: uv pip install faster-whisper.
# Some Homebrew ffmpeg bottles omit drawtext/subtitles/vidstab; videoforge detects this and tells you
# how to get a fuller build. Override the binaries here only if they're not on PATH:
# FFMPEG_BIN=
# FFPROBE_BIN=
# WHISPER_BACKEND=faster-whisper   # reserved for a future whisper.cpp backend
# Any-length tuning (defaults are fine): heavy edits wait inline up to INLINE_WAIT sec for a snappy
# result on short clips, else run UNBOUNDED as a background job (poll job_status). Apple hardware
# encoding (videotoolbox, 5-10x faster) auto-engages once a source is longer than HW_THRESHOLD sec.
# VIDEOFORGE_INLINE_WAIT=20
# VIDEOFORGE_HW_THRESHOLD=600

# === whatsapp + chrome (FREE; drive YOUR real Chrome, already logged in — no QR) ===
# Robust path uses WhatsApp's own engine (WPPConnect window.WPP) injected by a one-time unpacked Chrome
# extension — see integrations/whatsapp-wpp-extension/README.md. Plus: Chrome → View → Developer →
# "Allow JavaScript from Apple Events" + the Automation grant. macOS + Chrome. Talk to anyone by NAME/
# nickname (fuzzy) in YOUR per-contact voice; learns/persists nicknames, resolutions, tone, episodes.
# ⚠️ Automating WhatsApp's engine is against WhatsApp's ToS and bypasses rate limits — keep volume modest.
# CHROME_APP=Google Chrome           # e.g. "Google Chrome Beta"
# WHATSAPP_FUZZY_THRESHOLD=0.72      # auto-pick confidence for name matching (else asks "did you mean?")
# WHATSAPP_WPP_TIMEOUT=30            # sec to await a WPP call
# WHATSAPP_INLINE_WAIT=14            # sec an action waits inline before returning a job_id
# WHATSAPP_THROTTLE_SECONDS=3        # gap after each send (ban-safety)
# --- autopilot (autonomous conversation; triggered by "autopilot" in your prompt) ---
# WHATSAPP_AUTOPILOT_STOPWORDS=bye,bye bye,ok bye,goodbye,ttyl,gtg,good night,gn,stop,ruk,band karo
# WHATSAPP_AUTOPILOT_IDLE_TIMEOUT=180  # sec with no reply before autopilot stops
# WHATSAPP_AUTOPILOT_MAX_TURNS=40      # max back-and-forth turns before autopilot stops

# === background ("run any task in the background" engine) ===
# run(task) spawns a detached headless `claude -p` with the full suite. No keys (uses your Claude).
# BACKGROUND_MAX_CONCURRENT=4    # how many background tasks run at once
# BACKGROUND_TIMEOUT=1800        # per-task timeout (sec)
# BACKGROUND_INLINE_WAIT=8       # sec a task waits inline before returning a job_id
# BACKGROUND_YOLO=0             # 1 = headless runs use --dangerously-skip-permissions (max autonomy)
# CLAUDE_BIN=                   # path to the `claude` CLI if not on PATH

# === HTTP connection pool (shared across all 19+ servers that import http.py / fetch.py) ===
# A single long-lived httpx.Client per module; replaces per-call TCP+TLS handshakes (~40-70% latency cut).
# HTTP/2 requires `pip install h2`; silently falls back to HTTP/1.1 when absent.
# HTTP_POOL_MAX_KEEPALIVE=20      # max keep-alive connections per pool
# HTTP_POOL_MAX_CONNECTIONS=100   # max total connections per pool
# HTTP_POOL_KEEPALIVE_EXPIRY=30   # idle keep-alive TTL (seconds)
# HTTP_HTTP2=0                    # 1 = opt-in HTTP/2 (needs h2 installed)

# === bulk email-finder speed ===
# BULK_WORKERS=8                  # parallel workers for bulk_find (clamped 1-16)
# EMAIL_JOBS_MAX=3                # max concurrent bulk_find async jobs
# BULK_REVEAL_DELAY_S=1.5         # politeness pause between Apollo CDP reveals

# === Paths ===
# Where servers keep their SQLite DBs / caches. Defaults to ~/.mcp-suite
MCP_DATA_DIR=
